<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WordDeck</AssemblyName>
    <RootNamespace>WordDeck</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\oxford3000_uk.tsv.gz.b64part*" />
    <EmbeddedResource Include="QA\oxford5000_additions_translation.tsv" />
    <EmbeddedResource Include="QA\oxford5000_additions_second_pass_0101_0120.tsv" />
    <EmbeddedResource Include="QA\oxford5000_additions_second_pass_0121_0140.tsv" />
    <EmbeddedResource Include="QA\oxford5000_additions_second_pass_0141_0200.tsv" />
    <EmbeddedResource Include="QA\oxford5000_legacy_split_map_0001_0200.tsv" />
    <EmbeddedResource Include="QA\oxford5000_source_after_blow_c1_0001_0043.tsv" />
    <EmbeddedResource Include="QA\oxford5000_source_after_chamber_c1_0001_0029.tsv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
  </ItemGroup>
</Project>
