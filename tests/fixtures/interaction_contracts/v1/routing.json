        "policy": {"board_permission": "locked"},
        "message": {"version": 1, "family": "move", "raw_text": "e4"}
      },
      "decision": {
        "version": 1,
        "kind": "decision",
        "accepted": true,
        "effect": "chess_move",
        "reason": "explicit move input"
      }
    },
    {
