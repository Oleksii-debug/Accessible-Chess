        "message": {
          "version": 1,
          "family": "position_editor",
          "operation": "place_piece",
          "square": "e4",
          "piece": "Q",
          "value": null
        }
      },
      "decision": {
        "version": 1,
        "kind": "decision",
        "accepted": true,
        "effect": "position_edit",
        "reason": "explicit position edit"
      }
    },
    {
      "name": "student hover remains observation when moves are allowed",
      "request": {
        "version": 1,
        "kind": "request",
        "source": "student_surface",
        "policy": {"board_permission": "move_allowed"},
        "message": {
          "version": 1,
          "family": "student_hover",
          "square": "f3",
          "piece": "N",
          "student_id": "student-1",
          "sequence": 1
        }
      },
      "decision": {
        "version": 1,
        "kind": "decision",
        "accepted": true,
        "effect": "observation",
        "reason": "student event remains non-mutating"
      }
    },
    {
      "name": "student move is rejected by select-only policy",
      "request": {
        "version": 1,
        "kind": "request",
        "source": "student_surface",
        "policy": {"board_permission": "select_only"},
        "message": {"version": 1, "family": "move", "raw_text": "e4"}
      },
      "decision": {
        "version": 1,
        "kind": "decision",
