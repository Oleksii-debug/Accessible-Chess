    "ariaSnapshot": "- navigation:\n  - link:\n    - /url: /index\n    - img\n  - text: \"ChessBase Support Center Languages:\"\n  - link \"de\":\n    - /url: /de\n  - link \"en\":\n    - /url: /en\n  - list:\n    - listitem:\n      - link \"Home\":\n        - /url: /en/index\n    - listitem:\n      - link \"Shop\":\n        - /url: https://shop.chessbase.com/en/\n    - listitem:\n      - link \"News\":\n        - /url: https://en.chessbase.com/\n    - listitem:\n      - link \"Downloads\":\n        - /url: https://downloads.chessbase.com/en\n  - link \"Login\":\n    - /url: /en/login\n    - img\n    - text: Login\n  - text: Search\n  - searchbox \"Find answers\"\n  - button \"=>\"\n- heading \"Downloads\" [level=1]\n- heading [level=3]\n- heading \"The ChessBase Product-Installer\" [level=3]\n- paragraph\n- paragraph:\n  - text: \"Have you purchased a ChessBase software booklet with a printed serial number? Download the product installer here:\"\n  - link \"Download\":\n    - /url: https://downloads.chessbase.com/en\n- heading \"The ultimate chess experience. Try it out now!\" [level=3]\n- paragraph\n- text: If there is one place to play online chess, this is it! On Playchess.com, the world’s biggest chess server, you will find 20,000 chess lovers every day, from all over the world. You will immediately be able to find an opponent of your own playing strength, or if you fancy watching, you can kibitz grandmaster games and follow world class tournaments. Why not attend a training lesson or take part in a simultaneous exhibition against a grandmaster while you're at it? There is a room for beginners and hobby players, where you can also play without a chess clock.\n- strong\n- link \"Try out playchess.com free of charge and without any obligation.\":\n  - /url: https://download.chessbase.com/download/playchess/PlayChessV9Setup.exe\n  - strong: Try out playchess.com free of charge and without any obligation.\n- heading \"ChessBase Reader 2017\" [level=3]\n- paragraph\n- paragraph:\n  - text: ChessBase Reader 2017. The new ChessBase Reader conveniently displays all installed databases and training titles - with a modern menu ribbon look. With the free ChessBase reader, you can open all standard file formats (.cbh, .cbf, .pgn), play through games on a stunningly rendered board, watch ChessBase training videos and much more. Download it for free now!\n  - strong:\n    - link \"Free download available here.\":\n      - /url: https://download.chessbase.com/download/chessbasereader/Reader2017Setup_x86.msi\n- heading \"Manuals\" [level=3]\n- paragraph:\n  - link \"ChessBase 18\":\n    - /url: https://download.chessbase.com/download/pdf/cb18-eng.pdf\n  - link \"ChessBase 17\":\n    - /url: https://download.chessbase.com/download/pdf/cb17-eng.pdf\n  - link \"ChessBase 16\":\n    - /url: https://download.chessbase.com/download/pdf/cb16-eng.pdf\n  - link \"ChessBase 16 First Steps\":\n    - /url: https://download.chessbase.com/download/pdf/chessbase16-firststeps.pdf\n  - link \"ChessBase 16 First Steps Chinese\":\n    - /url: https://download.chessbase.com/download/pdf/ChessBase16_cn.pdf\n  - link \"ChessBase 16 French\":\n    - /url: https://help.chessbase.com/cb16-fra.pdf\n  - link \"ChessBase 16 Italian\":\n    - /url: https://download.chessbase.com/download/pdf/CB16-ita.pdf\n  - link \"ChessBase 16 Dutch\":\n    - /url: https://download.chessbase.com/download/pdf/CB16-ned.pdf\n  - link \"ChessBase 15\":\n    - /url: http://help.chessbase.com/cb15_eng.pdf\n  - link \"ChessBase 15 First Steps\":\n    - /url: https://download.chessbase.com/download/pdf/cb15/FirstStepsChessBase15.pdf\n  - link \"ChessBase 14\":\n    - /url: http://help.chessbase.com/cb14-eng.pdf\n  - link \"ChessBase 14 First Steps\":\n    - /url: https://download.chessbase.com/download/pdf/ChessBase14-FirstSteps.pdf\n  - link \"Fritz 19\":\n    - /url: https://help.chessbase.com/f19-eng.pdf\n  - link \"First steps with PowerFritz 18\":\n    - /url: https://help.chessbase.com/pdf/FirstStepswithPowerFritz18.pdf\n  - link \"Fritz18\":\n    - /url: https://help.chessbase.com/f18-eng.pdf\n  - link \"Fritz17\":\n    - /url: http://help.chessbase.com/F17-eng.pdf\n  - link \"Fritz16\":\n    - /url: http://help.chessbase.com/Fritz16-eng.pdf\n  - link \"ChessBase Account First Steps\":\n    - /url: https://download.chessbase.com/download/pdf/ChessBaseAccountFirstSteps.pdf\n  - link \"ChessBase Account\":\n    - /url: http://help.chessbase.com/webapps-eng.pdf\n- contentinfo:\n  - text: © 2023 - Support Center | ChessBase GmbH | Osterbekstr. 90a |22083 Hamburg | Germany |\n  - link \"Privacy\":\n    - /url: /Home/Privacy"
