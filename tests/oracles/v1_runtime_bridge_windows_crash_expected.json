  "invariants": [
    "legacy settings bytes unchanged",
    "legacy ACSDB bytes unchanged",
    "no completion marker while a partial journal remains",
    "SQLite quick_check=ok and foreign_key_check=[] for every surviving ACSDB",
    "restart/recovery enters only through V1RuntimeBridgeCoordinator.run()",
    "newer legitimate Settings/ACSDB writes are never overwritten",
    "successful recovery is idempotent"
  ],
  "cases": [
    {
      "id": "before_backup_completion",
      "injection": "abrupt termination during first stable backup copy",
      "expected_after_failure": {
        "journal": "absent",
        "completion_marker": "absent",
        "v2_settings": "absent",
        "v2_library": "absent",
        "legacy_bytes": "exact"
      },
      "expected_restart": "migrated_then_already_migrated"
    },
    {
      "id": "after_backup_before_journal",
      "injection": "abrupt termination immediately after durable backup manifest publication",
      "expected_after_failure": {
        "journal": "absent",
        "completion_marker": "absent",
        "v2_settings": "absent",
        "v2_library": "absent",
        "backup_manifest": "present",
        "legacy_bytes": "exact"
      },
      "expected_restart": "migrated_then_already_migrated"
    },
    {
      "id": "after_journal_publication",
      "injection": "abrupt termination at public phase hook prepared",
      "expected_after_failure": {
        "journal": "prepared",
        "completion_marker": "absent",
        "v2_settings": "absent",
        "v2_library": "absent",
        "legacy_bytes": "exact"
