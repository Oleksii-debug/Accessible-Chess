    {
      "name": "student move requires explicit move permission",
      "request": {
        "version": 1,
        "kind": "request",
        "source": "student_surface",
        "policy": {"board_permission": "move_allowed"},
        "message": {"version": 1, "family": "move", "raw_text": "e4"}
      },
      "decision": {
        "version": 1,
        "kind": "decision",
        "accepted": true,
        "effect": "chess_move",
        "reason": "explicit student move permitted"
